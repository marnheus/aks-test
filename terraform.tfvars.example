# Copy this file to terraform.tfvars and adjust values.
# Sensitive values are passed via GitHub Secrets (TF_VAR_* environment variables in CI).

# Azure region for all resources.
location = "westeurope"

# Name of the Azure resource group for the main infrastructure.
resource_group_name = "rg-aks-demo-westeurope"

# Backend resource group (created by Bicep deployment).
backend_resource_group = "rg-aks-backend-westeurope"

# Backend VNet name (created by Bicep deployment).
backend_vnet_name = "vnet-aksbackend"

# Tags applied to all resources.
tags = {
  environment = "demo"
  managed_by  = "terraform"
  project     = "aks-demo"
}

# Kubernetes version for the AKS cluster.
kubernetes_version = "1.33"
